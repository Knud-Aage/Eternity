<Project Sdk="Microsoft.NET.Sdk">

  <!-- Upstream targets netcoreapp3.1. Retargeted to net10.0 to match the
       binary that was actually built here (the PDB records obj/Release/net10.0)
       and the runtime installed on this machine. AllowUnsafeBlocks is required:
       Program.cs uses stackalloc and unsafe blocks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
